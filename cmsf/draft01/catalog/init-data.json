    {
      "id": "init-ref-dangling",
      "description": "initRef naming an id no initDataList entry has. MSF-01 5.2.13 defines initRef as pointing at an entry, and CMSF-01 3.1 puts every cmaf header behind one; neither says what a receiver does when the pointer misses, so this binds only a validator.",
      "input": {
        "text": "{\"version\": \"1\", \"tracks\": [{\"name\": \"video\", \"packaging\": \"cmaf\", \"isLive\": true, \"initRef\": \"init-missing\", \"role\": \"video\", \"codec\": \"avc1.640028\", \"width\": 1920, \"height\": 1080, \"bitrate\": 5000000, \"framerate\": 30}], \"initDataList\": [{\"id\": \"init-video\", \"type\": \"inline\", \"data\": \"AAAAGGZ0eXBjbWYyAAAAAGNtZjJpc282\"}]}"
      },
      "error": "unknown_reference",
      "error_detail": "tracks[0].initRef",
      "profiles": [
        "validator"
      ]
    },
    {
      "id": "init-id-duplicate",
