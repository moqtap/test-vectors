          "text": "{\"version\": 1, \"tracks\": []}"
        }
      ],
      "error": "illegal_update",
      "error_detail": "isComplete",
      "error_at": 1,
      "profiles": [
        "validator"
      ]
    },
    {
      "id": "independent-replaces",
      "description": "An independent catalog after a delta replaces everything before it: it is 'independent of other catalog objects' (5), so the track the delta added does not survive.",
      "input": {
        "text": "{\"version\": 1, \"generatedAt\": 1746104606044, \"tracks\": [{\"name\": \"video\", \"packaging\": \"loc\", \"isLive\": true, \"targetLatency\": 2000, \"codec\": \"av01\", \"bitrate\": 1500000}, {\"name\": \"audio\", \"packaging\": \"loc\", \"isLive\": true, \"targetLatency\": 2000, \"codec\": \"opus\", \"bitrate\": 32000}]}"
      },
      "steps": [
        {
          "text": "{\"deltaUpdate\": true, \"generatedAt\": 1746104606044, \"addTracks\": [{\"name\": \"slides\", \"packaging\": \"loc\", \"isLive\": true}]}"
        },
        {
          "text": "{\"version\": 1, \"generatedAt\": 1746104606044, \"tracks\": [{\"name\": \"video\", \"packaging\": \"loc\", \"isLive\": true, \"targetLatency\": 2000, \"codec\": \"av01\", \"bitrate\": 1500000}]}"
        }
