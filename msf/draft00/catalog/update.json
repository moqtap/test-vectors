      }
    },
    {
      "id": "is-complete-removed",
      "description": "An independent catalog without isComplete after one that had it: 5.1.7 'This field MUST NOT be removed from a catalog once it has been added.'",
      "input": {
        "text": "{\n  \"version\": 1,\n  \"generatedAt\": 1746104606044,\n  \"isComplete\": true,\n  \"tracks\": []\n}\n"
      },
      "steps": [
