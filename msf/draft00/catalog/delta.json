    {
      "id": "examples-5-3-4-and-5-3-5-tolerant",
      "description": "Sections 5.3.4 and 5.3.5 verbatim, applied in turn to a base that declares what they name: 'video-1080' to clone and 'video' to remove. The base is this corpus's, not the draft's. The track 5.3.4 adds has no packaging, which 5.1.12 marks Required: Yes. TOLERANT: the draft is silent on what a reader does with such a track; a tolerant reader applies the delta as written. `example-5-3-4-strict` is the validator's side.",
      "input": {
        "text": "{\"version\": 1, \"generatedAt\": 1746104606044, \"tracks\": [{\"name\": \"video\", \"packaging\": \"loc\", \"isLive\": true, \"role\": \"video\", \"codec\": \"av01.0.08M.10.0.110.09\", \"width\": 1920, \"height\": 1080, \"bitrate\": 1500000}, {\"name\": \"video-1080\", \"packaging\": \"loc\", \"isLive\": true, \"role\": \"video\", \"codec\": \"av01.0.08M.10.0.110.09\", \"width\": 1920, \"height\": 1080, \"framerate\": 30, \"bitrate\": 1500000, \"renderGroup\": 1}]}"
      },
      "steps": [
        {
          "text": "{\n  \"deltaUpdate\": true,\n  \"generatedAt\": 1746104606044,\n  \"addTracks\": [\n      {\n        \"name\": \"slides\",\n        \"isLive\": true,\n        \"role\": \"video\",\n        \"codec\": \"av01.0.08M.10.0.110.09\",\n        \"width\": 1920,\n        \"height\": 1080,\n        \"framerate\": 15,\n        \"bitrate\": 750000,\n        \"renderGroup\": 1\n      }\n   ],\n   \"cloneTracks\": [\n      {\n        \"parentName\": \"video-1080\",\n        \"name\": \"video-720\",\n        \"width\":1280,\n        \"height\":720,\n        \"bitrate\":600000\n      }\n   ]\n}\n"
        },
        {
          "text": "{\n  \"deltaUpdate\": true,\n  \"generatedAt\": 1746104606044,\n  \"removeTracks\": [{\"name\": \"video\"},{\"name\": \"slides\"}]\n}\n"
        }
