{
  "$schema": "../../../../schema/codec-vector.schema.json",
  "message_type": "request_update",
  "message_type_id": "0x02",
  "spec_section": "9.5",
  "vectors": [
    {
      "id": "minimal",
      "description": "minimal REQUEST_UPDATE with no parameters",
      "hex": "0200020200",
      "decoded": {
        "request_id": "2",
        "parameters": []
      }
    },
    {
      "id": "with-location-filter",
      "description": "REQUEST_UPDATE narrowing a subscription with a type 0x02 (Absolute Start) LOCATION_FILTER (StartGroup=5, StartObject=0). Section 9.20.9: \"If Location Filter Type is 0x02, StartGroup and StartObject follow.\" With every field below 128 these bytes are identical to draft-21's, where the byte after 0x21 was a Length that happened to equal the field count, so this vector cannot tell a draft-21 decoder from a draft-22 one",
      "hex": "020006010121020500",
      "decoded": {
        "request_id": "1",
        "parameters": [
          {
            "name": "location_filter",
            "type": "0x21",
            "value": {
              "filter_type": "2",
              "start_group": "5",
              "start_object": "0"
            }
          }
        ]
      }
    },
    {
      "id": "with-location-filter-removal",
      "description": "REQUEST_UPDATE clearing an existing LOCATION_FILTER with a type 0x00 filter. Section 9.20.9: \"If Location Filter Type is 0x00, no fields follow and there is no Location Filter.\" Section 9.5: \"There is no generic mechanism to remove a parameter from a request.\" Type 0x00 is therefore this parameter's own way to remove it, and omitting the parameter leaves the filter unchanged. The byte is the one draft-21 wrote as a zero Length, with the same effect",
      "hex": "02000401012100",
      "decoded": {
        "request_id": "1",
        "parameters": [
          {
            "name": "location_filter",
            "type": "0x21",
            "value": {
              "filter_type": "0"
            }
          }
        ]
      }
    },
    {
      "id": "with-fill-parameters-empty",
      "description": "REQUEST_UPDATE with an empty FILL_PARAMETERS (0x23), which opens an additional fill fetch stream on the subscription keyed by this REQUEST_UPDATE's Request ID. Length 1, value 00 (Number of Parameters = 0). FILL_PARAMETERS is not sticky: it applies only to the message carrying it",
      "hex": "0200050101230100",
      "decoded": {
        "request_id": "1",
        "parameters": [
          {
            "name": "fill_parameters",
            "type": "0x23",
            "value": []
          }
        ]
      }
    },
    {
      "id": "with-fill-parameters-location-filter",
      "description": "REQUEST_UPDATE whose FILL_PARAMETERS carries a type 0x03 LOCATION_FILTER selecting the inclusive fill range {3,0} through all of group 5, plus a FILL_TIMEOUT of 0 (deliver only immediately available Objects; report the rest with the End of Timed-Out Range marker). The inner delta chain runs 0x0A then 0x17",
      "hex": "02000c01012308020a001703030002",
      "decoded": {
        "request_id": "1",
        "parameters": [
          {
            "name": "fill_parameters",
            "type": "0x23",
            "value": [
              {
                "name": "fill_timeout",
                "type": "0xa",
                "value": "0"
              },
              {
                "name": "location_filter",
                "type": "0x21",
                "value": {
                  "end_group_delta": "2",
                  "filter_type": "3",
                  "start_group": "3",
                  "start_object": "0"
                }
              }
            ]
          }
        ]
      }
    },
